generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Utilisateur {
  id             String                 @id @default(uuid())
  courriel       String                 @unique
  motDePasseHash String
  nomAffiche     String
  creeLe         DateTime               @default(now())
  campagnes      Campagne[]
  sessions       Session[]
  preference     PreferenceUtilisateur?
}

model Campagne {
  id            String      @id
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  nom           String
  description   String?
  avatar        String
  supprime      Boolean     @default(false)
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt
  personnages   Personnage[]

  @@index([utilisateurId])
}

model Personnage {
  id           String          @id
  campagneId   String
  campagne     Campagne        @relation(fields: [campagneId], references: [id])
  nom          String
  race         String
  classe       String
  niveau       Int
  pvMax        Int
  pvActuels    Int
  force        Int
  dexterite    Int
  constitution Int
  intelligence Int
  sagesse      Int
  charisme     Int
  biographie   String?
  creeLe       DateTime        @default(now())
  modifieLe    DateTime        @updatedAt
  journal      EntreeJournal[]

  @@index([campagneId])
}

model EntreeJournal {
  id           String     @id
  personnageId String
  personnage   Personnage @relation(fields: [personnageId], references: [id])
  titre        String
  contenu      String
  dateSession  DateTime
  creeLe       DateTime   @default(now())

  @@index([personnageId])
}

model Session {
  id            String      @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  jetonHash     String      @unique
  expireLe      DateTime
}

model PreferenceUtilisateur {
  id            String      @id @default(uuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  theme         String      @default("PARCHEMIN")
}
